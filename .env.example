# Server Port
PORT=5000

# JWT Secret for signing authentication tokens
JWT_SECRET=eventpass_super_secure_jwt_secret_key_2026_xyz

# Supabase Configuration
# If left blank, the app runs in Local Mode (built-in secure store)
# When you create your Supabase project, paste your project credentials below:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default Quick Desk PINs (For rapid venue check-in without email/password)
DESK_ORGANIZER_PIN=9999
DESK_VOLUNTEER_PIN=1234
